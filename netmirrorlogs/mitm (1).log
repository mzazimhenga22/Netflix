    00:00:06,006 --> 00:00:09,510
    [jingle d'introduction]
    
    2
    00:00:10,844 --> 00:00:14,556
    [musique romantique : "Ain't That a Kick
    in the Head?" de Dean Martin]
    
    3
    00:00:29,821 --> 00:00:31,240
    [inaudibles]
    
    4
    00:00:40,374 --> 00:00:41,500
    [inaudibles]
    
    5
    00:00:47,548 --> 00:00:49,550
