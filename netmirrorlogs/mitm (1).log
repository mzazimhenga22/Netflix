    /**{-webkit-box-sizing: border-box;box-sizing: border-box;scrollbar-color:#4c0303 #000;-webkit-user-select: none;-moz-user-select: none;user-select: none;}*/
    * {
        -webkit-box-sizing: border-box;
        box-sizing: border-box;
        scrollbar-color: #4c0303 #000;
        -webkit-user-select: none;
        -moz-user-select: none;
        user-select: none;
    }
    
    body {
        text-rendering: auto;
        color: #fff;
        font-family: "Roboto", "HelveticaNeue-Light", sans-serif;
        margin: 0;
        background: black;
        font-weight: 600;
    }
    
    .app {
        max-width: 700px;
        margin: auto;
        transition: all 0.8s ease;
    }
    
    .app.effect {
        filter: blur(10px);
        transform: scale(0.95);
        opacity: 0.4;
    }
    
    .header {
        display: block;
        min-height: 120px;
        position: fixed;
        margin: 0 auto;
        top: 0;
        max-width: 700px;
        width: 100%;
        z-index: 1;
        font-family: "Roboto", "HelveticaNeue-Light", sans-serif;
        -webkit-transition: all 0.3s ease-in;
        -o-transition: all 0.3s ease-in;
        transition: all 0.3s ease-in;
    }
    
    .header:not(.hhide) {
        background: linear-gradient(#000 1%, #0006 50%, #0000 96%);
    }
    
    .header.hhide .nav-container {
        background: #00000094;
    }
    
    #header.hhide {
        min-height: auto;
    }
    
    .header .nav-container {
        padding: 5px 10px;
        margin-top: 0;
        min-height: 0;
        display: -webkit-box;
        display: -webkit-flex;
        display: -ms-flexbox;
        display: flex;
        -webkit-box-align: center;
        -webkit-align-items: center;
        -ms-flex-align: center;
        align-items: center;
    (cut off)

