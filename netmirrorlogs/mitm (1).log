    4
    00:00:54,888 --> 00:00:57,849
    [lautlos]
    
    5
    00:01:00,561 --> 00:01:01,812
    [lautlos]
    
    6
    00:01:01,895 --> 00:01:04,273
    ["Ain't That A Kick In The Head"
    spielt weiter]
    
    7
    00:01:16,243 --> 00:01:17,411
