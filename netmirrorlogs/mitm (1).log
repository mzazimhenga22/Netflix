    6
    00:00:53,220 --> 00:00:54,805
    [inaudibles]
    
    7
    00:01:16,243 --> 00:01:17,995
    [la musique s'arrête brusquement]
    
    8
    00:01:18,078 --> 00:01:20,247
    [musique dramatique]
    
    9
    00:01:21,540 --> 00:01:23,959
    [kiai répétés]
    
    10
    00:01:24,042 --> 00:01:27,504
    [les kiai continuent]
    
    11
    00:01:27,588 --> 00:01:29,089
    [les kiai s'intensifient]
    
    12
    00:01:30,257 --> 00:01:31,508
    [kiai en crescendo]
    
    13
